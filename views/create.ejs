<%- include("partials/header.ejs") %>

<h1 style="text-align:center;">CREATE BLOG HERE</h1>

<form action="/publish" method="POST" enctype="multipart/form-data" class="border border-secondary">
<div class="mb-3">
<label for="title class="form-label">Blog Title:</label>
<input type="text" class="form-control" placeholder="e.g Movie Blog" id="title" name="title" required></input>
</div>
<div class="mb-3">
<label for="author" class="form-label">Author:</label>
<input type="text" class="form-control" placeholder="Author name" id="author" name="author" required></input>
</div>
<div class="mb-3">
<label for="thumbnail" class="form-label">Thumnail:</label>
<input type="file" class="form-control" id="thumbnail" name="thumbnail" accept="image/*" required></input>
</div>
<div class="mb-3">
<label for="content" class="form-label">Content:</label>
<textarea class="form-control" placeholder="Type your content here" id="content" name="content" style="height: 100px"></textarea>
</div>

<input type="submit" class="btn btn-success" value="PUBLISH" />
</form>

<%- include("partials/footer.ejs") %>